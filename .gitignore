# Models (large files - download separately)
models/mixtral/*.gguf

# Knowledge base (user's private data)
knowledge/emails/
knowledge/documents/
knowledge/writing/
knowledge/projects/
knowledge/transcripts/
knowledge/.ingest_manifest.json
knowledge/emails/.pst_ingest_manifest.json

# Keep the folder structure
!knowledge/.gitkeep
!knowledge/emails/.gitkeep
!knowledge/documents/.gitkeep

# Vector database (regenerated from knowledge)
vectordb/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
.venv/
.env

# Node (web UI)
web/node_modules/
web/package-lock.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Local config overrides
config.local.yaml

# Training outputs (large files)
training/output/
training/data/
models/kyle-*.gguf
models/qwen2.5-14b/*.gguf
models/qwen3-30b-a3b-kyle/*.gguf
pipeline/config.yaml
knowledge/recordings/
training/*.log
training/logs/

# Private documents (not for GitHub)
docs/*.pptx
knowledge/datasheets/**/*.pdf
knowledge/datasheets/.datasheet_manifest.json
knowledge/images/
.skippy-env

# Eval narrative drafts (deck/story content, not for public GitHub)
eval/STORY_DRAFT.md
eval/*_DRAFT.md
eval/STORY*.md

# Local API keys (DO NOT COMMIT)
openaikey.txt
anthropickey.txt

# Model weights — NEVER commit (only 3 legacy mixtral JSON configs are tracked).
# .gitignore does not untrack those; this only stops NEW model files/dirs.
models/**/*.gguf
models/**/*.safetensors
models/**/*.bin
models/qwen2.5-7b-fp16/
models/oracle_run/
# Eval result backups (regenerable tarballs)
eval/results_backup_*.tar.gz
